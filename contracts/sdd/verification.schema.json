{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "runId", "verdict", "changedFiles", "acceptanceCriteriaVerified", "checks", "remainingRisks", "blocker"],
  "properties": {
    "status": {"enum": ["verified", "blocked"]},
    "runId": {"type": "string", "minLength": 8},
    "verdict": {"type": "string"},
    "changedFiles": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteriaVerified": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not-run"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "remainingRisks": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": "string"}
  }
}
