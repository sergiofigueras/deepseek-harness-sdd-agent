{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "runId", "summary", "changedFiles", "acceptanceCriteriaPlanned", "acceptanceCriteriaImplemented", "checks", "blocker"],
  "properties": {
    "status": {"enum": ["implemented", "blocked"]},
    "runId": {"type": "string", "minLength": 8},
    "summary": {"type": "string"},
    "changedFiles": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteriaPlanned": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
    "acceptanceCriteriaImplemented": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
    "checks": {"$ref": "#/definitions/checks"},
    "blocker": {"type": "string"}
  },
  "definitions": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not-run"]},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
