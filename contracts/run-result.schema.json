{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/contracts/run-result.schema.json",
  "title": "Deterministic replay result",
  "oneOf": [
    { "$ref": "#/definitions/success" },
    { "$ref": "#/definitions/businessOutcome" },
    { "$ref": "#/definitions/failure" }
  ],
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logPath"],
      "properties": {
        "logPath": { "type": "string", "minLength": 1 },
        "screenshotPath": { "type": "string", "minLength": 1 },
        "htmlSnapshotPath": { "type": "string", "minLength": 1 }
      }
    },
    "baseProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "capabilityId", "startedAt", "finishedAt", "evidence"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "capabilityId",
        "startedAt",
        "finishedAt",
        "evidence",
        "outputs",
        "recoveriesApplied"
      ],
      "properties": {
        "kind": { "const": "success" },
        "runId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/definitions/evidence" },
        "outputs": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "recoveriesApplied": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "businessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "capabilityId",
        "startedAt",
        "finishedAt",
        "evidence",
        "outcome",
        "description",
        "data"
      ],
      "properties": {
        "kind": { "const": "business_outcome" },
        "runId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/definitions/evidence" },
        "outcome": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    },
    "failureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message", "retryable"],
      "properties": {
        "category": {
          "enum": [
            "policy_denied",
            "invalid_invocation",
            "target_missing",
            "permission_denied",
            "session_expired",
            "retry_exhausted",
            "checkpoint_mismatch",
            "intervention_required",
            "internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "stepIndex": { "type": "integer", "minimum": 0 },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "capabilityId",
        "startedAt",
        "finishedAt",
        "evidence",
        "failure"
      ],
      "properties": {
        "kind": { "const": "failure" },
        "runId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/definitions/evidence" },
        "failure": { "$ref": "#/definitions/failureDetail" }
      }
    }
  }
}
