{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/contracts/capability.schema.json",
  "title": "Computer-use capability artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "application",
    "inputs",
    "outputs",
    "steps",
    "checkpoint",
    "businessOutcomes",
    "recoveries",
    "declaredRisk",
    "provenance",
    "review",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "application": { "$ref": "#/definitions/application" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/input" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/output" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "checkpoint": { "$ref": "#/definitions/assertion" },
    "businessOutcomes": {
      "type": "array",
      "items": { "$ref": "#/definitions/businessOutcome" }
    },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "#/definitions/recovery" }
    },
    "declaredRisk": { "$ref": "#/definitions/risk" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "review": { "$ref": "#/definitions/review" },
    "appliedOverlay": { "$ref": "#/definitions/appliedOverlay" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "definitions": {
    "risk": { "enum": ["safe", "risky", "irreversible"] },
    "primitiveType": { "enum": ["string", "number", "boolean"] },
    "jsonPrimitive": { "type": ["string", "number", "boolean", "null"] },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "product", "baseUrlPattern", "compatibleVersionRange", "driftFingerprint"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "baseUrlPattern": { "type": "string", "minLength": 1 },
        "compatibleVersionRange": { "type": "string", "minLength": 1 },
        "driftFingerprint": { "type": "string", "minLength": 8 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "required", "sensitive"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "type": { "$ref": "#/definitions/primitiveType" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "pattern": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "required", "locator", "extraction"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "type": { "$ref": "#/definitions/primitiveType" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "locator": { "$ref": "#/definitions/locatorBundle" },
        "extraction": { "enum": ["text", "value", "attribute"] },
        "attributeName": { "type": "string", "minLength": 1 }
      }
    },
    "roleLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "role"],
      "properties": {
        "strategy": { "const": "role" },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "exact": { "type": "boolean" }
      }
    },
    "labelLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "text"],
      "properties": {
        "strategy": { "const": "label" },
        "text": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" }
      }
    },
    "textLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "text"],
      "properties": {
        "strategy": { "const": "text" },
        "text": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" }
      }
    },
    "cssLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "selector"],
      "properties": {
        "strategy": { "const": "css" },
        "selector": { "type": "string", "minLength": 1 }
      }
    },
    "coordinateLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "x", "y", "referenceFingerprint"],
      "properties": {
        "strategy": { "const": "coordinate" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "referenceFingerprint": { "type": "string", "minLength": 8 }
      }
    },
    "locatorCandidate": {
      "oneOf": [
        { "$ref": "#/definitions/roleLocator" },
        { "$ref": "#/definitions/labelLocator" },
        { "$ref": "#/definitions/textLocator" },
        { "$ref": "#/definitions/cssLocator" },
        { "$ref": "#/definitions/coordinateLocator" }
      ]
    },
    "locatorBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "robustnessNote"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/locatorCandidate" }
        },
        "framePath": {
          "type": "array",
          "items": { "$ref": "#/definitions/locatorCandidate" }
        },
        "robustnessNote": { "type": "string", "minLength": 1 }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": {
        "source": { "const": "input" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "literalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "const": "literal" },
        "value": { "$ref": "#/definitions/jsonPrimitive" }
      }
    },
    "valueExpression": {
      "oneOf": [
        { "$ref": "#/definitions/inputReference" },
        { "$ref": "#/definitions/literalValue" }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": { "const": "url_matches" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "const": "visible" },
            "locator": { "$ref": "#/definitions/locatorBundle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "pattern"],
          "properties": {
            "kind": { "const": "text_matches" },
            "locator": { "$ref": "#/definitions/locatorBundle" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outputName", "expected"],
          "properties": {
            "kind": { "const": "output_equals" },
            "outputName": { "type": "string", "minLength": 1 },
            "expected": { "$ref": "#/definitions/valueExpression" }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "risk", "description", "timeoutMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["navigate", "click", "type", "read", "wait"] },
        "risk": { "$ref": "#/definitions/risk" },
        "description": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/locatorBundle" },
        "value": { "$ref": "#/definitions/valueExpression" },
        "outputName": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "postcondition": { "$ref": "#/definitions/assertion" },
        "recoveryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "businessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "condition"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/definitions/assertion" },
        "data": { "type": "object" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "maxAttempts", "backoffMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": {
          "enum": ["known_dialog", "transient_load", "known_interstitial", "temporary_unavailable"]
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoffMs": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/definitions/step" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoveredAt", "model", "sourceTarget", "evidenceRunId"],
      "properties": {
        "discoveredAt": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1 },
        "sourceTarget": { "type": "string", "minLength": 1 },
        "evidenceRunId": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "approved", "rejected"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "appliedOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayId", "tenantId", "appVersion"],
      "properties": {
        "overlayId": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string", "minLength": 1 },
        "appVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
